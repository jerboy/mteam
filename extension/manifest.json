{
  "manifest_version": 3,
  "name": "M-Team 资源助手",
  "version": "1.11.0",
  "description": "搜索 M-Team 资源、发送到多个 qBittorrent 下载器、查看下载进度和管理任务，并提供结果刷新与定期网页访问。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "downloads",
    "clipboardWrite",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://api.m-team.cc/*",
    "https://api.m-team.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "M-Team 资源助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http: https:"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
